{
  "_comment": "Workshop — must-gather Approval demo。複製：cp config/agent_config.workshop.example.json config/agent_config.json",
  "case_id": "04444508",
  "llm": {
    "provider": "gemini",
    "model": "gemini-3.1-flash-lite",
    "api_key_env": "GEMINI_API_KEY"
  },
  "trigger": {
    "mode": "demo",
    "require_explicit_request_in_demo": true
  },
  "approval": {
    "enabled": true,
    "ttl_hours": 24,
    "required_tools": [
      "oc_adm_must_gather",
      "upload_attachment_rh_portal",
      "pods_exec"
    ],
    "connector_reply": {
      "mode": "customer_status"
    }
  },
  "enterprise": {
    "audit_trail": true
  },
  "polling": {
    "interval_seconds": 10,
    "cooldown_after_reply_seconds": 30
  },
  "diagnostics": {
    "bundle_output": {
      "mode": "overflow_only",
      "spill_threshold_chars": 1500
    }
  }
}
